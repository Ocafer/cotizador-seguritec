# Copia este archivo como .env y completa los valores para desarrollo local
# El archivo .env nunca debe subirse al repositorio (ya está en .gitignore)

# --- Base de datos ---
# Dejar vacío para usar SQLite local (app.db)
# En producción (Railway): se configura automáticamente
DATABASE_URL=

# --- Autenticación ---
ADMIN_USER=seguritec
ADMIN_PASS=cambia_esto

# --- Sesión ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=cambia_esto_tambien

# --- Empresa ---
# (Opcional) Sobreescribe los valores por defecto definidos en config.py
# LOGO_PATH=static/logo.png
